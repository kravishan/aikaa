---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import visual from '../assets/aikaa-visual.jpg';
import Timeline from '../components/Timeline.astro';
import Journey from '../components/Journey.astro';
import { url } from '../lib/url';
import { PARTNERS } from '../lib/nav';

const offers = [
  {
    title: 'AI Model Guide',
    text: 'Pick a task, say a customer email or a meeting summary, and see which tools suit it and what to watch out for with your data.',
    path: 'guide/',
    action: 'Open the guide',
    main: true,
  },
  {
    title: 'Safe Use',
    text: 'What to check before you paste anything into ChatGPT or Copilot. There is also a one-page AI policy you can copy and adapt.',
    path: 'safe-use/',
    action: 'Read the checklist',
  },
  {
    title: 'Workshops',
    text: 'Staff take one of their own tasks apart step by step and mark where the pressure builds up. Then we look at what AI could do about it, and what it could not. About four hours.',
    path: 'approach/',
    action: 'See the approach',
  },
  {
    title: 'Blog',
    text: 'Notes from the project as it goes. Short, because you are busy.',
    path: 'blog/',
    action: 'Read the blog',
  },
];

const aims = [
  { title: 'Feel better at work', text: 'Well-being comes first. Productivity should go up with it, not at its cost.' },
  { title: 'Less rush', text: 'Less time pressure and stress in an ordinary working day.' },
  { title: 'AI in real tasks', text: 'Generative AI used in the everyday work people actually do.' },
  { title: 'Share what works', text: 'We write up what worked, so other Finnish companies can try it too.' },
];

const journey = [
  { title: 'Kick-off meeting' },
  { title: 'Quality of Working Life survey', text: 'For all staff' },
  { title: 'Rush and time pressure survey' },
  { title: 'Generative AI maturity interview', text: 'Five dimensions' },
  { title: 'Workshops' },
  { title: 'Pilot project', text: 'One focused process, human review always' },
  { title: 'Final survey and reporting' },
];

const pathways = [
  {
    title: 'Company managers',
    text: 'You want to know what taking part involves, and how to let staff use AI without losing control of your data.',
    links: [
      { label: 'What taking part involves', path: 'approach/' },
      { label: 'One-page AI usage policy template', path: 'safe-use/' },
      { label: 'Compare AI tools', path: 'guide/' },
    ],
  },
  {
    title: 'Staff',
    text: 'You have emails to answer and meeting notes to write up. Start with the task in front of you.',
    links: [
      { label: 'Find a tool for your task', path: 'guide/' },
      { label: 'Before you paste anything', path: 'safe-use/' },
      { label: 'What happens in a workshop', path: 'approach/' },
    ],
  },
  {
    title: 'Funders, universities and the public',
    text: 'What the project set out to do, who runs it and what we have found so far.',
    links: [
      { label: 'About the project', path: 'project/' },
      { label: 'Partners and roles', path: 'project/' },
      { label: 'Contact the team', path: 'contact/' },
    ],
  },
];

const findings = [
  { title: 'Workflows are the weak spot', text: 'Staff feel safe and get on with their colleagues. What frustrates them is how work moves from one person or system to the next.' },
  { title: 'AI is a private habit', text: 'Some people already use AI tools on their own. None of the companies has agreed yet where AI should be used.' },
  { title: 'Data before AI', text: 'Paper records, systems that do not talk to each other, client data with strict rules. These come first.' },
  { title: 'Say it out loud', text: 'Staff need to hear, plainly, that this project is not about replacing them.' },
];
---
<Base title="AIKAA">
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero__inner">
      <div>
        <p class="hero__eyebrow">Research project · November 2025 to February 2028</p>
        <h1 id="hero-title">Less rush at work, with AI that stays in its place.</h1>
        <p class="hero__lede">
          AIKAA works with 32 small and mid-sized companies across Finland. We find out where the rush comes from, then test whether generative AI can take some of it away. People stay in charge.
        </p>
        <div class="hero__actions">
          <a class="button" href={url('guide/')}>Open the AI Model Guide</a>
          <a class="text-link" href={url('project/')}>About the project</a>
        </div>
      </div>
      <figure class="hero__visual">
        <Image
          src={visual}
          alt="Two head silhouettes, one cyan and one magenta, overlap around an alarm clock, gears and numbers. The image stands for time and work."
          widths={[480, 760, 1100]}
          sizes="(min-width: 56rem) 45vw, 100vw"
          loading="eager"
          fetchpriority="high"
          format="webp"
          quality={78}
        />
      </figure>
    </div>
  </section>

  <section class="section" aria-label="Key facts" style="padding-top: var(--space-xl)">
    <div class="container">
      <dl class="facts-strip">
        <div><dt>2025 to 2028</dt><dd>Project period</dd></div>
        <div><dt>32</dt><dd>Companies across Finland</dd></div>
        <div><dt>4</dt><dd>Universities</dd></div>
        <div><dt>ESF+</dt><dd>Co-funded by the European Union</dd></div>
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="offer-title" style="padding-top: 0">
    <div class="container">
      <div class="section__head">
        <h2 id="offer-title">What you will find here</h2>
        <p>Free to read and print. Some pages are still being written.</p>
      </div>
      <ul class="offer-grid">
        {offers.map((o) => (
          <li class:list={['offer', { 'offer--main': o.main }]}>
            {o.main && <span class="offer__flag">Start here</span>}
            <h3>{o.title}</h3>
            <p>{o.text}</p>
            <a class="button" href={url(o.path)}>{o.action}</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="aims-title">
    <div class="container">
      <div class="section__head">
        <h2 id="aims-title">What we are aiming for</h2>
        <p>"Aikaa" is Finnish for "time", which is what most people we meet at work are short of.</p>
      </div>
      <ol class="numbered">
        {aims.map((a) => (
          <li><h3>{a.title}</h3><p>{a.text}</p></li>
        ))}
      </ol>
      <Timeline />
    </div>
  </section>

  <section class="section" aria-labelledby="journey-title">
    <div class="container">
      <div class="section__head">
        <h2 id="journey-title">What happens in a company</h2>
        <p>Every company goes through the same seven steps. Nobody's job is on the table.</p>
      </div>
      <Journey stages={journey} label="The seven stages of the company journey" />
      <p style="margin-top: var(--space-l)"><a class="text-link" href={url('approach/')}>How each step works</a></p>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="paths-title">
    <div class="container">
      <div class="section__head">
        <h2 id="paths-title">Where to start</h2>
        <p>That depends on who you are.</p>
      </div>
      <ul class="pathways">
        {pathways.map((p) => (
          <li class="pathway">
            <h3>{p.title}</h3>
            <p>{p.text}</p>
            <ul>
              {p.links.map((l) => <li><a href={url(l.path)}>{l.label}</a></li>)}
            </ul>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="findings-title">
    <div class="container">
      <div class="section__head">
        <h2 id="findings-title">What we have learned so far</h2>
        <p>From the first round of company assessments. We keep it general here, so no names and no numbers.</p>
      </div>
      <ol class="numbered">
        {findings.map((f) => (
          <li><h3>{f.title}</h3><p>{f.text}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="partners-title">
    <div class="container">
      <div class="section__head">
        <h2 id="partners-title">Partners</h2>
        <p>Four Finnish universities. Haaga-Helia coordinates.</p>
      </div>
      <ul class="partners">
        {PARTNERS.map((p) => (
          <li>
            <img class="partners__logo" src={url(p.logo)} alt="" width={p.w} height={p.h} style={`height: ${p.show + 8}px`} />
            <a href={p.url}>{p.name}</a>
            <span>{p.role}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="cta" aria-labelledby="cta-title">
    <div class="container cta__inner">
      <div>
        <h2 id="cta-title">Questions about AIKAA?</h2>
        <p>Ask the project team.</p>
      </div>
      <a class="button" href={url('contact/')}>Contact us</a>
    </div>
  </section>
</Base>
