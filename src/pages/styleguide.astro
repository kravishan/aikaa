---
/**
 * Hidden style guide. Not linked from the site, not in the sitemap, not indexed.
 * Shows every design token and component in one place.
 */
import Base from '../layouts/Base.astro';
import TimeRule from '../components/TimeRule.astro';
import Timeline from '../components/Timeline.astro';
import Journey from '../components/Journey.astro';
import WorkshopBar from '../components/WorkshopBar.astro';
import ModelCard from '../components/ModelCard.astro';
import Confirm from '../components/Confirm.astro';

const colours = [
  ['--paper', 'Page background'],
  ['--surface', 'Cards and tables'],
  ['--ink', 'Main text'],
  ['--ink-muted', 'Secondary text'],
  ['--rule', 'Decorative lines'],
  ['--rule-strong', 'Borders of clickable parts'],
  ['--primary', 'Indigo: links, buttons'],
  ['--primary-tint', 'Highlight backgrounds'],
  ['--primary-dark', 'Hover state, footer'],
  ['--accent', 'Magenta: small details only'],
  ['--accent-text', 'Magenta as text'],
  ['--decor', 'Cyan: thin lines only'],
  ['--paper-alt', 'Alternate sections'],
  ['--fit-strong', '"Strong fit" labels'],
  ['--fit-caution', '"Use with care" labels'],
];

const journey = [
  { title: 'Kick-off meeting' },
  { title: 'Quality of Working Life survey', text: 'For all staff' },
  { title: 'Rush and time pressure survey' },
  { title: 'Generative AI maturity interview', text: 'Five dimensions' },
  { title: 'Workshops' },
  { title: 'Pilot project', text: 'One focused process, human review always' },
  { title: 'Final survey and reporting' },
];

const workshop = [
  { title: 'Introduction', minutes: 75 },
  { title: 'Current state', minutes: 45 },
  { title: 'Root causes with an AI assistant', minutes: 30 },
  { title: 'Solution ideas and AI critique', minutes: 75 },
  { title: 'Future vision and feedback', minutes: 30 },
];
---
<Base title="Style guide" noindex>
  <div class="container section">
    <p class="label">Internal · Not linked from the site</p>
    <h1>AIKAA style guide</h1>
    <p class="lede">Every colour, type style and component used on the site. White background, black text, colours from the AIKAA project image.</p>

    <TimeRule />

    <section class="split" aria-labelledby="sg-colour">
      <h2 id="sg-colour" class="label">Colour</h2>
      <div>
        <ul class="swatches">
          {colours.map(([token, use]) => (
            <li class="swatch">
              <div class="swatch__chip" style={`background: var(${token})`}></div>
              <div class="swatch__meta">
                <strong>{use}</strong>
                <code>{token}</code>
              </div>
            </li>
          ))}
        </ul>
        <p>All text colours pass WCAG 2.1 AA (4.5:1 or more) on their backgrounds. White text on indigo is 12.9:1. Cyan is never used for text.</p>
      </div>
    </section>

    <TimeRule />

    <section class="split" aria-labelledby="sg-type">
      <h2 id="sg-type" class="label">Typography</h2>
      <div>
        <h1>Heading 1 in IBM Plex Sans</h1>
        <h2>Heading 2 for page sections</h2>
        <h3>Heading 3 for sub-sections</h3>
        <h4>Heading 4 for small groups</h4>
        <p class="lede">Lede text introduces a page in one or two short sentences.</p>
        <p>
          Body text is IBM Plex Sans at about 17 to 18 pixels with a line height of 1.6. Lines stay under about 68 characters so they are easy to read. Here is <a href="#sg-type">a text link</a> and some <code>inline code</code>.
        </p>
        <p lang="fi">Suomen kielen merkit: ä, ö, å, Ä, Ö, Å. Työhyvinvointi, kiire ja äly.</p>
        <p class="label">Mono label · 1 Nov 2025 · Työpaja</p>
        <h3 lang="fi">Älykästä ja inhimillistä automaatiota</h3>
      </div>
    </section>

    <TimeRule />

    <section class="split" aria-labelledby="sg-time">
      <h2 id="sg-time" class="label">Time rule</h2>
      <div>
        <h3>Section divider</h3>
        <p>A thin line with small ticks separates sections across the site.</p>
        <TimeRule />
        <h3>Project timeline</h3>
        <p>The marker shows today. It is calculated when the site is built.</p>
        <Timeline />
      </div>
    </section>

    <TimeRule />

    <section aria-labelledby="sg-journey">
      <div class="split">
        <h2 id="sg-journey" class="label">Company journey</h2>
        <p>Seven stages on the time rule. Horizontal on wide screens, vertical on phones. One stage can be highlighted.</p>
      </div>
      <Journey stages={journey} highlight={4} label="The seven stages of the company journey" />
    </section>

    <TimeRule />

    <section class="split" aria-labelledby="sg-workshop">
      <h2 id="sg-workshop" class="label">Workshop bar</h2>
      <div>
        <p>Each part's width matches its minutes. On phones the parts stack, and the shaded length still shows the time.</p>
        <WorkshopBar parts={workshop} />
      </div>
    </section>

    <TimeRule />

    <section class="split" aria-labelledby="sg-controls">
      <h2 id="sg-controls" class="label">Buttons and links</h2>
      <div class="stack">
        <p>
          <a class="button" href="#sg-controls">Open the AI Model Guide</a>
          <a class="button button--secondary" href="#sg-controls">Print cheat sheet</a>
        </p>
        <p><a class="text-link" href="#sg-controls">Read about the approach</a></p>
      </div>
    </section>

    <TimeRule />

    <section class="split" aria-labelledby="sg-tags">
      <h2 id="sg-tags" class="label">Tags, chips and labels</h2>
      <div class="stack">
        <h3>Tags</h3>
        <ul class="tag-list">
          <li class="tag">writing</li>
          <li class="tag">analysis</li>
          <li class="tag">technical</li>
        </ul>
        <h3>Filter chips</h3>
        <div class="tag-list" role="group" aria-label="Example filter">
          <button class="chip" type="button" aria-pressed="true">Writing</button>
          <button class="chip" type="button" aria-pressed="false">Analysis</button>
          <button class="chip" type="button" aria-pressed="false">Technical</button>
          <button class="chip" type="button" aria-pressed="false">Sensitive data</button>
        </div>
        <h3>Fit labels</h3>
        <p>
          <span class="fit fit--strong">Strong fit</span>&nbsp;&nbsp;
          <span class="fit fit--caution">Use with care</span>&nbsp;&nbsp;
          <span class="fit fit--neutral">Not tested</span>
        </p>
        <h3>Facts to confirm</h3>
        <p>Total budget: <Confirm /> and managing authority: <Confirm note="ask coordinator" /></p>
      </div>
    </section>

    <TimeRule />

    <section class="split" aria-labelledby="sg-callouts">
      <h2 id="sg-callouts" class="label">Callouts</h2>
      <div class="stack">
        <div class="callout">
          <span class="callout__title">Note</span>
          <p>AI suggests. A person decides.</p>
        </div>
        <div class="callout callout--caution" role="note">
          <span class="callout__title">Personal or client data</span>
          <p>Do not paste personal or client data into a free AI tool. Read the Safe Use page first.</p>
        </div>
      </div>
    </section>

    <TimeRule />

    <section aria-labelledby="sg-cards">
      <div class="split">
        <h2 id="sg-cards" class="label">Model cards</h2>
        <p>Sample cards with placeholder content. Real tool facts are added in Phase 4 after the fact check.</p>
      </div>
      <div class="card-grid">
        <ModelCard
          name="Example tool A"
          href="#sg-cards"
          provider="Example provider"
          country="Country"
          strongAt={['Drafting emails and short texts', 'Summarising long documents', 'Building spreadsheet formulas']}
          lessSuitedFor={['Image generation', 'Sensitive data on free plans']}
          euDataOption="[CONFIRM]"
          trainsOnConsumerData="[CONFIRM]"
          businessPlan="Yes"
          freePlan="Yes"
          paidFrom="[CONFIRM]"
          finnish="Good"
          lastReviewed="Oct 2026"
          tags={['writing', 'technical']}
        />
        <ModelCard
          name="Example tool B"
          provider="Example provider"
          country="Country"
          strongAt={['Research with cited sources', 'Quick fact finding']}
          lessSuitedFor={['Long internal documents', 'Drafting']}
          euDataOption="[CONFIRM]"
          trainsOnConsumerData="[CONFIRM]"
          businessPlan="[CONFIRM]"
          freePlan="Yes"
          paidFrom="[CONFIRM]"
          finnish="Not tested"
          lastReviewed="Oct 2026"
          tags={['research']}
        />
      </div>
    </section>

    <TimeRule />

    <section class="split" aria-labelledby="sg-table">
      <h2 id="sg-table" class="label">Table</h2>
      <div class="table-wrap">
        <table class="table--sticky">
          <caption class="visually-hidden">Example task to tool table</caption>
          <thead>
            <tr><th scope="col">Task</th><th scope="col">Suggested tools</th><th scope="col">Safety note</th><th scope="col" class="num">Minutes</th></tr>
          </thead>
          <tbody>
            <tr><th scope="row">Write customer emails</th><td>Tool A, Tool B</td><td>Remove names and contact details first</td><td class="num">10</td></tr>
            <tr><th scope="row">Summarise a meeting</th><td>Tool C</td><td>Tell participants before recording</td><td class="num">5</td></tr>
            <tr><th scope="row">Translate</th><td>Tool D</td><td>Check names, numbers and terms</td><td class="num">15</td></tr>
          </tbody>
        </table>
      </div>
    </section>
  </div>
</Base>

<script>
  // Style guide only: let the example chips toggle.
  document.querySelectorAll<HTMLButtonElement>('.chip').forEach((chip) => {
    chip.addEventListener('click', () => {
      chip.setAttribute('aria-pressed', String(chip.getAttribute('aria-pressed') !== 'true'));
    });
  });
</script>
